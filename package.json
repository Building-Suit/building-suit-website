    "tokens:verify": "node scripts/verify-building-suit-design-system.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@hugeicons/core-free-icons": "4.2.1",
    "@hugeicons/vue": "1.0.6",
    "@nuxtjs/supabase": "1.6.2",
    "@primevue/nuxt-module": "4.5.5",
    "@tailwindcss/vite": "4.3.3",
    "gsap": "3.15.0",
    "motion-v": "2.3.0",
    "nuxt": "4.5.2",
    "primevue": "4.5.5",
    "tailwindcss": "4.3.3",
    "vue": "3.5.42",
    "vue-router": "5.3.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vue-tsc": "3.3.11",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "sharp": "0.35.3",
    "vitest": "2.1.8"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
