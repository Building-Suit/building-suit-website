      "200": { "$value": { "colorSpace": "srgb", "components": [0.886275, 0.898039, 0.917647], "alpha": 1, "hex": "#E2E5EA" } },
      "300": { "$value": { "colorSpace": "srgb", "components": [0.796078, 0.823529, 0.858824], "alpha": 1, "hex": "#CBD2DB" } },
      "400": { "$value": { "colorSpace": "srgb", "components": [0.694118, 0.721569, 0.752941], "alpha": 1, "hex": "#B1B8C0" } },
