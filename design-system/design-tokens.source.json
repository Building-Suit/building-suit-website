  "gradient": {
    "$type": "gradient",
    "gold": {
      "$value": [
        { "color": "{color.brand.highlightGold}", "position": 0 },
        { "color": "{color.brand.premiumGold}", "position": 0.5 },
        { "color": "{color.brand.gold700}", "position": 1 }
      ],
      "$extensions": { "com.building-suit.css": { "angle": "135deg" } }
    },
    "navy": {
      "$value": [
        { "color": "{color.brand.buildingNavy}", "position": 0 },
        { "color": "{color.brand.deepStructureNavy}", "position": 1 }
      ],
      "$extensions": { "com.building-suit.css": { "angle": "160deg" } }
    }
