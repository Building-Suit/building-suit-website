{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "com.building-suit.metadata": {
      "name": "Building Suit Design Tokens",
      "version": "2.0.0",
      "format": "DTCG 2025.10",
      "canonical": true,
      "goldUsageRule": "Maximum one large gold focal element per screen. Smaller functional gold states—focus, selection and active indicators—are allowed when they do not compete visually."
    }
  },
  "color": {
    "$description": "Core brand, product interface, functional and data-visualization colors.",
