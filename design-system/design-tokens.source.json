        "errorBackground": { "$value": { "colorSpace": "srgb", "components": [0.972549, 0.890196, 0.890196], "alpha": 1, "hex": "#F8E3E3" } },
        "errorBorder": { "$value": "{color.functional.light.errorForeground}" },
