      "deepStructureNavy": { "$value": { "colorSpace": "srgb", "components": [0.05098, 0.105882, 0.156863], "alpha": 1, "hex": "#0D1B28" } },
      "premiumGold": { "$value": { "colorSpace": "srgb", "components": [0.847059, 0.607843, 0.258824], "alpha": 1, "hex": "#D89B42" } },
      "highlightGold": { "$value": { "colorSpace": "srgb", "components": [0.921569, 0.705882, 0.352941], "alpha": 1, "hex": "#EBB45A" } },
