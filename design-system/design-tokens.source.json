      "800": { "$value": { "colorSpace": "srgb", "components": [0.145098, 0.172549, 0.2], "alpha": 1, "hex": "#252C33" } },
      "850": { "$value": { "colorSpace": "srgb", "components": [0.109804, 0.133333, 0.156863], "alpha": 1, "hex": "#1C2228" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.082353, 0.101961, 0.121569], "alpha": 1, "hex": "#151A1F" } },
      "950": { "$value": { "colorSpace": "srgb", "components": [0.054902, 0.066667, 0.078431], "alpha": 1, "hex": "#0E1114" } },
